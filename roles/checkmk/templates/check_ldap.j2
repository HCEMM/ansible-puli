#!/bin/bash

LDAP_HOST="{{ ldap_server_fqdn }}"
LDAP_PORT="{{ ldap_port | default('389') }}"
LDAP_BASE_DN="{{ ldap_base_dn | default('dc=cluster,dc=hcemm,dc=eu') }}"

if ldapsearch -x \
  -H "ldap://${LDAP_HOST}:${LDAP_PORT}" \
  -b "${LDAP_BASE_DN}" \
  -s base >/dev/null 2>&1
then
    echo "0 LDAP_Query - LDAP query successful (${LDAP_HOST}:${LDAP_PORT})"
else
    echo "2 LDAP_Query - LDAP query failed (${LDAP_HOST}:${LDAP_PORT})"
fi