#!/bin/bash

KDC_HOST="{{ ldap_server_fqdn }}"
KDC_PORT="{{ kerberos_kdc_port | default('88') }}"

timeout 5 bash -c "</dev/tcp/${KDC_HOST}/${KDC_PORT}" >/dev/null 2>&1
RC=$?

if [ "$RC" -eq 0 ]; then
    echo "0 Kerberos_KDC_Port - KDC reachable (${KDC_HOST}:${KDC_PORT})"
else
    echo "2 Kerberos_KDC_Port - KDC unreachable (${KDC_HOST}:${KDC_PORT})"
fi