#!/bin/bash
set -euo pipefail

LDAPADD="ldapadd -x -D {{ ldap_local_admin_dn }} -w {{ ldap_local_admin_password }}"
LDAPMOD="ldapmodify -x -D {{ ldap_local_admin_dn }} -w {{ ldap_local_admin_password }}"
LDAPSEARCH="ldapsearch -x -D {{ ldap_local_admin_dn }} -w {{ ldap_local_admin_password }}"
LDAPSEARCH_AD="ldapsearch -x -H ldap://{{ ldap_ad_server }} -D '{{ ldap_ad_bind_dn }}' -w '{{ ldap_ad_bind_password }}' -b '{{ ldap_ad_base_dn }}'"

TMPDIR=$(mktemp -d)   # make a mock temporary directory

# -------------------------------------------
# 1. Extract AD info for all users using the cluster
# -------------------------------------------

echo "[INFO] Extracting user attributes from AD..."

# Generate list of emails from ldap_ad_users
EMAIL_LIST=$(mktemp)
cat <<EOF > "$EMAIL_LIST"
{% for u in ldap_ad_users %}
{{ u.email }}
{% endfor %}
EOF

# Query AD for each email, retrieve only email and name attributes
AD_EXPORT="$TMPDIR/ad_users.ldif"
echo -n > "$AD_EXPORT"

while read -r EMAIL; do
    echo "[INFO] Fetching AD entry for $EMAIL"

    $LDAPSEARCH_AD "(mail=$EMAIL)" \
        mail sAMAccountName cn sn givenName \
        >> "$AD_EXPORT" || true

done < "$EMAIL_LIST"

# Remove comments
grep -v '^#' "$AD_EXPORT" > "$AD_EXPORT.cleaned"
mv "$AD_EXPORT.cleaned" "$AD_EXPORT"

# -------------------------------------------
# 2. Build LDIF entries for local OpenLDAP
# -------------------------------------------

USERS_LDIF="$TMPDIR/local_users.ldif"
echo -n > "$USERS_LDIF"

{% set group_gid = {} %}
{% for g in ldap_user_groups %}
{% set _ = group_gid.update({g.name: g.gid}) %}
{% endfor %}

echo "[INFO] Building LDIF containing POSIX users..."

{% for u in ldap_ad_users %}
cat <<EOF >> "$USERS_LDIF"
dn: uid={{ u.username }},ou=People,{{ ldap_local_suffix }}
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
objectClass: posixAccount
cn: {{ u.username }}
sn: {{ u.username }}
uid: {{ u.username }}
mail: {{ u.email }}
uidNumber: {{ u.uid }}
gidNumber: {{ group_gid[u.groups[0]] }}
homeDirectory: /home/{{ u.username }}
loginShell: /bin/bash
EOF

# Add user's POSIX group memberships
{% for g in u.groups %}
cat <<EOF >> "$USERS_LDIF"
memberOf: cn={{ g }},ou=Groups,{{ ldap_local_suffix }}
EOF
{% endfor %}

echo "" >> "$USERS_LDIF"
{% endfor %}

# -------------------------------------------
# 3. Apply LDIF to OpenLDAP (add or update)
# -------------------------------------------

echo "[INFO] Applying LDIF to OpenLDAP..."

# Try modify first; if entry does not exist, add it
if ! $LDAPMOD -f "$USERS_LDIF" 2>/dev/null; then
    echo "[WARN] ldapmodify failed; trying ldapadd..."
    $LDAPADD -f "$USERS_LDIF"
fi

echo "[INFO] Sync completed successfully."

rm -rf "$TMPDIR"
