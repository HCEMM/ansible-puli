#!/usr/bin/env bash
set -euo pipefail

QR_SIZE="${1:-10}"
OUTFILE="${2:-$HOME/otp-${USER}.png}"

need() { command -v "$1" >/dev/null 2>&1 || { echo "Missing command: $1"; exit 1; }; }
need ipa
need klist
need kinit
need qrencode
need awk
need id
need hostname

USER="$(id -un)"
HOST="$(hostname -f 2>/dev/null || hostname)"

if ! klist -s; then
  echo "No Kerberos ticket found. Running: kinit ${USER}"
  kinit "${USER}"
fi

OUT="$(ipa otptoken-add --type=totp --desc="TOTP for ${USER}@${HOST}")"

URI="$(echo "$OUT" | awk '/URI:/ {print $2; exit}')"
if [ -z "${URI:-}" ]; then
  echo "Could not find OTP URI in ipa output."
  echo "$OUT"
  exit 1
fi

echo "OTP token created for ${USER}"
echo "URI: ${URI}"
echo

echo "Writing QR PNG to: ${OUTFILE}"
echo "${URI}" | qrencode -o "${OUTFILE}" -s "${QR_SIZE}" -m 1
echo
echo "Terminal QR (note: size scaling may not apply in ANSIUTF8):"
echo "${URI}" | qrencode -t ANSIUTF8 -m 1
