<domain type='qemu'>
  <name>{{ vm_name }}</name>
  <memory unit='MiB'>{{ vm_memory }}</memory>
  <vcpu placement='static'>{{ vm_vcpu }}</vcpu>
  <os>
    <type arch='x86_64' machine='pc-q35-rhel9.6.0'>hvm</type>     <!-- hvm -> OS is to run on bare metal, so requires full virtualization. For arch/machine, see: https://libvirt.org/formatcaps.html -->
    <boot dev='cdrom'/>                                           <!-- Boot from CD-ROM first -->
    <boot dev='hd'/>                                              <!-- If CD-ROM not found, boot from hard disk -->
  </os>
  <cpu mode='host-model' check='none'/>
  <devices>
    <emulator>/usr/libexec/qemu-kvm</emulator>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/tmp/AlmaLinux-9.6-x86_64-minimal.iso'/>
      <target dev='sda' bus='sata'/>                              <!-- QEMU machine (pc-q35-rhel9.6.0) does not support IDE controllers by default -->
      <readonly/>
    </disk>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2'/>
      <source file='/var/lib/libvirt/images/{{ vm_name }}.qcow2'/>
      <target dev='vda' bus='virtio'/>
      <address type='pci' domain='0x0000' bus='0x05' slot='0x00' function='0x0'/>
    </disk>
    <interface type='bridge'>
      <source bridge='br0'/>                                      <!-- Must be created previously!!! --> 
      <model type='virtio'/>
      <address type='pci' domain='0x0000' bus='0x01' slot='0x00' function='0x0'/>
    </interface>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
      <address type='virtio-serial' controller='0' bus='0' port='1'/>
    </channel>
    <input type='tablet' bus='usb'>
      <address type='usb' bus='0' port='1'/>
    </input>
    <input type='mouse' bus='ps2'/>
    <input type='keyboard' bus='ps2'/>
    <memballoon model='virtio'>
      <address type='pci' domain='0x0000' bus='0x06' slot='0x00' function='0x0'/>
    </memballoon>
    <rng model='virtio'>
      <backend model='random'>/dev/urandom</backend>
      <address type='pci' domain='0x0000' bus='0x07' slot='0x00' function='0x0'/>
    </rng>
    <serial type='pty'>     <!-- Use a pseudo-terminal for serial console -->
      <target type='isa-serial' port='0'/>
    </serial>
    <console type='pty'>    <!-- Use a pseudo-terminal for console -->
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>