{% for conn in guacamole_connections %}
INSERT INTO guacamole_connection (connection_name, protocol)
SELECT '{{ conn.name }}', '{{ conn.protocol }}'
WHERE NOT EXISTS (
    SELECT 1
    FROM guacamole_connection
    WHERE connection_name = '{{ conn.name }}'
);

{% for key, value in conn.parameters.items() %}
INSERT INTO guacamole_connection_parameter (connection_id, parameter_name, parameter_value)
SELECT c.connection_id, '{{ key }}', '{{ value | replace("'", "''") }}'
FROM guacamole_connection c
WHERE c.connection_name = '{{ conn.name }}'
AND NOT EXISTS (
    SELECT 1
    FROM guacamole_connection_parameter p
    WHERE p.connection_id = c.connection_id
      AND p.parameter_name = '{{ key }}'
);
{% endfor %}

{% for user in ldap_users %}
INSERT INTO guacamole_entity (name, type)
SELECT '{{ user.username }}', 'USER'
WHERE NOT EXISTS (
    SELECT 1
    FROM guacamole_entity
    WHERE name = '{{ user.username }}'
      AND type = 'USER'
);

INSERT INTO guacamole_user (entity_id, password_hash, password_salt, password_date)
SELECT e.entity_id, '', '', NOW()
FROM guacamole_entity e
WHERE e.name = '{{ user.username }}'
AND NOT EXISTS (
    SELECT 1
    FROM guacamole_user u
    WHERE u.entity_id = e.entity_id
);

INSERT INTO guacamole_connection_permission (entity_id, connection_id, permission)
SELECT e.entity_id, c.connection_id, 'READ'
FROM guacamole_entity e
JOIN guacamole_connection c
  ON c.connection_name = '{{ conn.name }}'
WHERE e.name = '{{ user.username }}'
AND NOT EXISTS (
    SELECT 1
    FROM guacamole_connection_permission cp
    WHERE cp.entity_id = e.entity_id
      AND cp.connection_id = c.connection_id
      AND cp.permission = 'READ'
);
{% endfor %}

{% endfor %}

{% for username in guacamole_admin_users | default([]) %}
INSERT INTO guacamole_entity (name, type)
SELECT '{{ username }}', 'USER'
WHERE NOT EXISTS (
    SELECT 1
    FROM guacamole_entity
    WHERE name = '{{ username }}'
      AND type = 'USER'
);

INSERT INTO guacamole_user (entity_id, password_hash, password_salt, password_date)
SELECT e.entity_id, '', '', NOW()
FROM guacamole_entity e
WHERE e.name = '{{ username }}'
AND NOT EXISTS (
    SELECT 1
    FROM guacamole_user u
    WHERE u.entity_id = e.entity_id
);

INSERT INTO guacamole_system_permission (entity_id, permission)
SELECT e.entity_id, 'ADMINISTER'
FROM guacamole_entity e
WHERE e.name = '{{ username }}'
AND NOT EXISTS (
    SELECT 1
    FROM guacamole_system_permission sp
    WHERE sp.entity_id = e.entity_id
      AND sp.permission = 'ADMINISTER'
);
{% endfor %}