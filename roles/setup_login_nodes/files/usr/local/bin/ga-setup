#!/bin/bash
# Wrapper for google-authenticator with auto QR resizing

USER=$(whoami)
HOST=$(hostname -s)

# -t = time-based, -D = allow multiple uses, -f = force overwrite, -u = disable rate-limiting, -l = overwrite URL, -i = the issuer I think, -C = non-interactive mode
OUTPUT=$(google-authenticator -t -D -f -u -w 3 -l "${USER}@${HOST}" -i "${HOST}" -C)

# Extract the otpauth URL
URL=$(echo "$OUTPUT" | grep -o 'otpauth://.*')

if [[ -z "$URL" ]]; then
  echo "❌ Could not find otpauth URL."
  exit 1
fi

# Check terminal size (columns)
COLUMNS=$(tput cols)
# Pick QR scale based on terminal width
if [ "$COLUMNS" -lt 60 ]; then
  SCALE=1
elif [ "$COLUMNS" -lt 100 ]; then
  SCALE=2
else
  SCALE=3
fi

# Allow override with parameter - this is not working that good
if [ -n "$1" ]; then
  SCALE=$1
fi

echo "✅ Google Authenticator secret generated for ${USER}@${HOST}"
echo
echo "Scan this QR code with your authenticator app:"
echo "$URL" | qrencode -t ANSIUTF8 -s "$SCALE"
echo
echo "Or manually enter the secret:"
echo "$URL"