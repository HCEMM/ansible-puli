# ============================================================
# This file is managed by Ansible.
# Manual edits will be overwritten on next deployment.
# ============================================================

{% for service in nginx_gateway_services %}
upstream {{ service.name }} {
{% for backend in service.backends %}
    server {{ backend }};
{% endfor %}

{% if service.keepalive is defined %}
    # DoctorLLM: keep upstream connections alive
    keepalive {{ service.keepalive }};
{% endif %}
}

server {
    listen 80;
    server_name {{ service.server_name }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{ service.server_name }};

    ssl_certificate /etc/letsencrypt/live/{{ service.server_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ service.server_name }}/privkey.pem;

{% if service.client_max_body_size is defined %}
    # DoctorLLM: allow larger request bodies
    client_max_body_size {{ service.client_max_body_size }};
{% endif %}

{% if service.name != "doctorllm" %}
    access_log /var/log/nginx/{{ service.name }}.log;

    proxy_intercept_errors on;

    error_page 500 502 503 504 =503 /maintenance.html;

    location = /maintenance.html {
        root /var/www/errors;

        ssi on;

        set $service_name $host;

        add_header Cache-Control "no-store";
    }

    location = /hcemm-logo.jpg {
        alias /var/www/errors/hcemm-logo.jpg;
    }
{% endif %}

    # Security headers
    add_header X-Content-Type-Options "nosniff";
    add_header X-Frame-Options "DENY";
    add_header Referrer-Policy "strict-origin-when-cross-origin";
    add_header X-XSS-Protection "1; mode=block";

    {% if service.static is defined %}
    location /static/ {
        alias /srv/galaxy/server/static/;
        expires 30d;
        access_log off;
    }
    {% endif %}

    {% if service.tusd is defined %}
    # tusd resumable uploads
    location /api/upload/resumable_upload {
        # Disable request and response buffering
		proxy_request_buffering     off;
		proxy_buffering             off;
		proxy_http_version          1.1;

		# Add X-Forwarded-* headers
		proxy_set_header X-Forwarded-Host   $host;
		proxy_set_header X-Forwarded-Proto  $scheme;

		proxy_set_header Upgrade            $http_upgrade;
		proxy_set_header Connection         "upgrade";
		client_max_body_size        0;
		proxy_pass http://{{ service.tusd }}/files;
    }
    {% endif %}

    location / {
        proxy_pass http://{{ service.name }};

{% if service.websocket | default(false) %}
        # DoctorLLM: Open WebUI WebSocket support
        proxy_http_version 1.1;
{% endif %}

        proxy_set_header Host              $host;

{% if service.websocket | default(false) %}
        proxy_set_header X-Real-IP         $remote_addr;
{% endif %}

        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

{% if service.websocket | default(false) %}
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
{% endif %}

{% if service.proxy_connect_timeout is defined %}
        proxy_connect_timeout {{ service.proxy_connect_timeout }};
{% endif %}

{% if service.proxy_send_timeout is defined %}
        proxy_send_timeout {{ service.proxy_send_timeout }};
{% endif %}

{% if service.proxy_read_timeout is defined %}
        proxy_read_timeout {{ service.proxy_read_timeout }};
{% endif %}

{% if service.proxy_buffering is defined %}
        proxy_buffering {{ service.proxy_buffering }};
{% endif %}

        proxy_redirect off;
    }
    
    {% if service.x_accel_redirect is defined %}
    location /_x_accel_redirect/ {
        internal;
        alias /;
        # Add upstream response headers that would otherwise be omitted
        add_header Access-Control-Allow-Origin $upstream_http_access_control_allow_origin;
        add_header Access-Control-Allow-Methods $upstream_http_access_control_allow_methods;
    }
    {% endif %}
}

{% endfor %}

# DoctorLLM WebSocket support
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}