
global
    log 127.0.0.1 local2
    daemon
    maxconn 2000

defaults
    mode tcp
    log global
    option tcplog
    timeout connect 5s
    timeout client  2h
    timeout server  2h
    timeout check   5s

frontend fe_ssh
    bind 0.0.0.0:{{ haproxy_ssh_listen_port }}
    default_backend be_ssh

backend be_ssh
    balance {{ haproxy_balance }}
    option tcp-check
    tcp-check connect
{% for h in groups[haproxy_backend_group] %}
    server {{ h }} {{ hostvars[h].ansible_host | default(hostvars[h].ansible_default_ipv4.address) }}:{{ haproxy_backend_port }} check
{% endfor %}
