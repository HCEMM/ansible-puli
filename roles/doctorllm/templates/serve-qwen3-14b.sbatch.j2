#!/bin/bash

# ============================================================
# Managed by the DoctorLLM Ansible role.
#
# CURRENT POLICY:
# This job is NOT submitted automatically by Ansible.
# Submit it manually as the FreeIPA user "doctorllm".
#
# Automatic lifecycle management may be added later if the
# DoctorLLM GPU allocation model changes.
# ============================================================

#SBATCH --job-name={{ doctorllm_vllm_job_name }}
#SBATCH --account={{ doctorllm_slurm_account }}
#SBATCH --qos={{ doctorllm_slurm_qos }}
#SBATCH --partition={{ doctorllm_slurm_partition }}
#SBATCH --nodelist={{ doctorllm_vllm_node }}
#SBATCH --gres={{ doctorllm_vllm_gres }}
#SBATCH --time={{ doctorllm_vllm_time }}
#SBATCH --output={{ doctorllm_nfs_mount }}/logs/serve-qwen3-14b-%j.out
#SBATCH --error={{ doctorllm_nfs_mount }}/logs/serve-qwen3-14b-%j.err

set -euo pipefail

export HOME={{ doctorllm_nfs_mount }}/tmp/doctorllm-home
export HF_HOME={{ doctorllm_nfs_mount }}/cache/huggingface
export HUGGINGFACE_HUB_CACHE={{ doctorllm_nfs_mount }}/cache/huggingface/hub
export TORCH_HOME={{ doctorllm_nfs_mount }}/cache/torch
export XDG_CACHE_HOME={{ doctorllm_nfs_mount }}/tmp/doctorllm-home/.cache
export VLLM_CACHE_ROOT={{ doctorllm_nfs_mount }}/cache/doctorllm-vllm
export TOKENIZERS_PARALLELISM=false

VLLM_ENV={{ doctorllm_vllm_current }}
MODEL_PATH={{ doctorllm_model_path }}
API_KEY_FILE={{ doctorllm_vllm_api_key_file }}

echo "Node: $(hostname -f)"
echo "Job ID: ${SLURM_JOB_ID}"
echo "CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-unset}"
echo "Model: ${MODEL_PATH}"
echo "Started: $(date --iso-8601=seconds)"

echo "Checking vLLM executable"; test -x "$VLLM_ENV/bin/vllm" || { echo "ERROR: vLLM executable inaccessible"; exit 11; }
echo "Checking model"; test -r "$MODEL_PATH/config.json" || { echo "ERROR: model config inaccessible"; exit 12; }
echo "Checking API key"; test -r "$API_KEY_FILE" || { echo "ERROR: API key inaccessible"; exit 13; }

API_KEY="$(cat "$API_KEY_FILE")"

nvidia-smi --query-gpu=name,driver_version,memory.total \
  --format=csv,noheader

export TORCHINDUCTOR_CACHE_DIR="/tmp/torchinductor-${SLURM_JOB_ID}"
export TRITON_CACHE_DIR="/tmp/triton-${SLURM_JOB_ID}"
mkdir -p "$TORCHINDUCTOR_CACHE_DIR" "$TRITON_CACHE_DIR"
export FLASHINFER_WORKSPACE_DIR={{ doctorllm_nfs_mount }}/tmp/doctorllm-cache/flashinfer
export VLLM_USE_FLASHINFER_SAMPLER=0
exec "$VLLM_ENV/bin/vllm" serve "$MODEL_PATH" \
  --served-model-name {{ doctorllm_vllm_served_model_name }} \
  --host 0.0.0.0 \
  --port {{ doctorllm_vllm_port }} \
  --api-key "$API_KEY" \
  --dtype auto \
  --max-model-len {{ doctorllm_vllm_max_model_len }} \
  --gpu-memory-utilization {{ doctorllm_vllm_gpu_memory_utilization }} \
  --enforce-eager \
  --enable-prefix-caching
